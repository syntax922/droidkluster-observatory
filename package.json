{
  "name": "droidkluster-observatory",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "check:redaction": "node scripts/check-redaction.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:e2e": "npm run build --workspace @observatory/core --workspace @observatory/site && npx playwright test --config packages/site/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
